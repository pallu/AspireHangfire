@page "/"
@using AspireHangfire.JobLibrary
@using Hangfire

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.
<div>
    <button class="btn btn-primary" @onclick="EnqueueJob">Enqueue Job</button>
    <div class="mt-3">
        @str
    </div>
</div>

@code{
    [Inject] IBackgroundJobClient backgroundJobClient { get; set; } = default!;
    string? str;

    private void EnqueueJob()
    {
        //str = backgroundJobClient.Enqueue(() => Console.WriteLine("Hello from Hangfire!"));
        var message = $"Hello from Hangfire! The time is {DateTime.UtcNow:O}";
        str = backgroundJobClient.Enqueue<IPrintingJobs>(x => x.PrintMessageAsync(message));
    }
}
